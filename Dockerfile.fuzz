FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    librocksdb-dev \
    rustc \
    cargo \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY . .

RUN uv sync

COPY docker-entrypoint-fuzz.sh /usr/local/bin/docker-entrypoint-fuzz.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-fuzz.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint-fuzz.sh"]
